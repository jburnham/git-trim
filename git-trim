#!/usr/bin/env bash

# Use git-sh-setup, similar to git-recommand
# https://www.kernel.org/pub/software/scm/git/docs/git-sh-setup.html
OPTIONS_STUCKLONG=true
OPTIONS_SPEC="\
git trim [options]

Removes merged, pruned, untracked, and stale branches within a repository.
https://github.com/jasonmccreary/git-trim/
--
  Available options are:
all!              remove all local branches, except the current branch
dry-run!          prints branches which will be removed instead of deleting them
porcelain!        print one tab-separated line per branch in a stable format for scripts
m,merged!         remove local branches already merged into the current branch
p,pruned!         remove local branches where its remote branch no longer exists
r,remote!         remove remote branches instead of local branches
reset=?           remove all local branches except those existing on remote (default: origin)
s,stale!          remove local branches without commits in the last 3 months
q,squashed!       remove local branches already squash-merged into the current branch
t,tracked!        remove the tracking branch from remote
u,untracked!      remove local branches not tracking a remote branch
"

SUBDIRECTORY_OK='Yes' . "$(git --exec-path)/git-sh-setup"


# Functions
filter_branches() {
  local restore_glob=0
  if [[ ! -o noglob ]]; then
    restore_glob=1
    set -o noglob
  fi
  local exclude=( $(git config gt.exclude) )
  [ $restore_glob -eq 1 ] && set +o noglob
  [ -n "$default_branch" ] && exclude+=("$default_branch")

  if [ ${#exclude} -eq 0 ]; then
    echo "$@"
    return
  fi

  local branches=()

  for branch in "$@"; do
    if [ $remote -eq 1 ]; then
      for excluded in "${exclude[@]}"; do
        if [[ "$branch" == */$excluded ]]; then
          continue 2
        fi
      done

      branches+=("$branch")
    else
      local matched=0
      for excluded in "${exclude[@]}"; do
        if [[ "$branch" == $excluded ]]; then
          matched=1
          break
        fi
      done

      [ $matched -eq 0 ] && branches+=("$branch")
    fi
  done

  echo "${branches[*]}"
}

prune_all() {
  git fetch --all -p > /dev/null 2>&1
}

remove_tracking_branch() {
  local remote=$(git config "branch.${1}.remote")

  if [ -z "$remote" ]; then
    return
  fi

  local upstream_branch_full_name=$(git config "branch.$1.merge")
  local upstream_branch=${upstream_branch_full_name#"refs/heads/"}

  remove_remote_branch $remote $upstream_branch
}

remove_remote_branch() {
  if [ $dry_run -eq 1 ]; then
    if [ $porcelain -eq 1 ]; then
      printf 'delete-remote\t%s\t%s\n' "$1" "$2"
    else
      echo "$2 will be deleted from $1."
    fi
  else
    git push -d $1 $2 >/dev/null 2>&1
    if [ $? -eq 0 ]; then
      if [ $porcelain -eq 1 ]; then
        printf 'delete-remote\t%s\t%s\n' "$1" "$2"
      else
        echo "Deleted branch $2 (on $1)."
      fi
    fi
  fi
}

worktree_path() {
  git worktree list --porcelain | awk -v ref="branch refs/heads/$1" '/^worktree /{path=substr($0, 10)} $0 == ref {print path; exit}'
}

skip_worktree_branch() {
  local path=$(worktree_path "$1")

  if [ -z "$path" ]; then
    return 1
  fi

  if [ $porcelain -eq 1 ]; then
    printf 'skip-worktree\t%s\t%s\n' "$1" "$path"
  else
    echo "Skipping branch $1 (checked out in worktree at $path)."
  fi
}

remove_local_branch() {
  if [ $dry_run -eq 1 ]; then
    if [ $porcelain -eq 1 ]; then
      printf 'delete\t%s\n' "$1"
    else
      echo "$1 will be deleted."
    fi
  elif [ $porcelain -eq 1 ]; then
    git branch -D $1 >/dev/null && printf 'delete\t%s\n' "$1"
  else
    git branch -D $1
  fi
}

nothing_to_trim() {
  [ $porcelain -eq 1 ] || echo "$1"
  exit 0
}


# Defaults
all=0
dry_run=0
porcelain=0
merged=0
pruned=0
squashed=0
stale=0
tracked=0
untracked=0
remote=0
reset=''
current_branch=$(git symbolic-ref -q --short HEAD)
default_branch=$(git symbolic-ref -q --short refs/remotes/origin/HEAD)
default_branch=${default_branch#origin/}
worktree_branches=( $(git worktree list --porcelain | grep '^branch ' | sed 's|^branch refs/heads/||') )
options=$#

# Parse options
while [ $# != 0 ]; do
  case "$1" in
    --all) all=1;;
    --stale) stale=1;;
    --squashed) squashed=1;;
    --merged) merged=1;;
    --pruned) pruned=1;;
    --tracked) tracked=1;;
    --untracked) untracked=1;;
    --remote) remote=1;;
    --reset=*) reset="${1#*=}";;
    --reset) reset='origin';;
    --dry-run) dry_run=1;;
    --porcelain) porcelain=1;;
    --) ;;
  esac
  shift
done

if [[ $options -eq $((1 + dry_run + porcelain)) ]]; then
  pruned=1
fi


# all
if [ $all -eq 1 ]; then
  while true; do
    read -p "Are you sure you want to remove all branches? " choice
    case $(echo $choice | tr '[A-Z]' '[a-z]') in
      y|yes) break;;
      *) exit;;
    esac
  done

  command='git branch'
  if [ $remote -eq 1 ]; then
    prune_all
    command="$command -a"
  fi

  branches=( $($command | grep -v '^\*' | cut -c3-) )
  if [ $remote -eq 1 ]; then
    branches=( $(printf '%s\n' "${branches[@]}" | grep -vF "/$current_branch") )
  fi
  branches=( $(filter_branches "${branches[@]}") )

  if [ ${#branches} -eq 0 ]; then
    nothing_to_trim "No branches need to be trimmed."
  fi

  for branch in "${branches[@]}"; do
    if [ $remote -eq 1 ]; then
      if [ "${branch:0:8}" == "remotes/" ]; then
        name="${branch:8}"
        remove_remote_branch ${name%%/*} ${name#*/}
      fi
    else
      skip_worktree_branch $branch && continue
      remove_local_branch $branch

      if [ $tracked -eq 1 ]; then
        remove_tracking_branch $branch
      fi
    fi
  done
fi


# merged
if [ $merged -eq 1 ]; then
  command='git branch'
  if [ $remote -eq 1 ]; then
    prune_all
    command="$command -r"
  fi

  branches=( $($command --merged | grep -v '^\*' | cut -c3-) )
  if [ $remote -eq 1 ]; then
    branches=( $(printf '%s\n' "${branches[@]}" | grep -vF "/$current_branch") )
  fi
  branches=( $(filter_branches "${branches[@]}") )

  if [ ${#branches} -eq 0 ]; then
    nothing_to_trim "There are no merged branches to trim."
  fi

  for branch in "${branches[@]}"; do
    if [ $remote -eq 1 ]; then
      remove_remote_branch ${branch%%/*} ${branch#*/}
    else
      skip_worktree_branch $branch && continue

      if [ $tracked -eq 1 ]; then
        remove_tracking_branch $branch
      fi

      remove_local_branch $branch
    fi
  done
fi


# squashed
if [ $squashed -eq 1 ]; then
  command='git for-each-ref --format=%(refname:short)'
  if [ $remote -eq 1 ]; then
    prune_all
    command="$command refs/remotes/"
  else
    command="$command refs/heads/"
  fi

  all_branches=( $($command) )
  all_branches=( $(filter_branches "${all_branches[@]}") )
  branches=()

  for branch in "${all_branches[@]}"; do
    if [ "$branch" == "$current_branch" ]; then
      continue
    fi
    if [ $remote -eq 1 ] && [[ " ${worktree_branches[*]} " =~ " ${branch#*/} " ]]; then
      continue
    fi

    merge_base=$(git merge-base $current_branch $branch 2>/dev/null) || continue
    tree_commit=$(git commit-tree $(git rev-parse "$branch^{tree}") -p $merge_base -m _) || continue

    if [[ $(git cherry $current_branch $tree_commit) == "-"* ]]; then
      branches+=($branch)
    fi
  done

  if [ ${#branches} -eq 0 ]; then
    nothing_to_trim "There are no squash-merged branches to trim."
  fi

  for branch in "${branches[@]}"; do
    if [ $remote -eq 1 ]; then
      remove_remote_branch ${branch%%/*} ${branch#*/}
    else
      skip_worktree_branch $branch && continue

      if [ $tracked -eq 1 ]; then
        remove_tracking_branch $branch
      fi

      remove_local_branch $branch
    fi
  done
fi


# pruned
if [ $pruned -eq 1 ]; then
  prune_all
  branches=( $(LANG=C git branch -vv | grep -v '^\*' | cut -c3- | awk '/: gone]/{print $1}') )
  branches=( $(filter_branches "${branches[@]}") )

  if [ ${#branches} -eq 0 ]; then
    nothing_to_trim "There are no local branches to trim."
  fi

  for branch in "${branches[@]}"; do
    skip_worktree_branch $branch && continue
    remove_local_branch $branch
  done
fi


# stale
if [ $stale -eq 1 ]; then
  command='git branch'
  if [ $remote -eq 1 ]; then
    prune_all
    command="$command -r"
  fi

  all_branches=( $($command | grep -v '^\*' | cut -c3-) )
  all_branches=( $(filter_branches "${all_branches[@]}") )
  branches=()

  for branch in "${all_branches[@]}"; do
    [[ $(git log -1 -s --since="3 months ago" $branch) ]] || branches+=($branch)
  done

  if [ ${#branches} -eq 0 ]; then
    nothing_to_trim "There are no stale branches to trim."
  fi

  for branch in "${branches[@]}"; do
    if [ $remote -eq 1 ]; then
      remove_remote_branch ${branch%%/*} ${branch#*/}
    else
      skip_worktree_branch $branch && continue
      remove_local_branch $branch
    fi
  done
fi


# untracked
if [ $untracked -eq 1 ]; then
  branches=( $(git branch --format='%(if)%(upstream)%(then)%(else)%(refname:short)%(end)' | awk NF) )
  branches=( $(filter_branches "${branches[@]}") )

  if [ ${#branches} -eq 0 ]; then
    nothing_to_trim "There are no untracked branches to trim."
  fi

  for branch in "${branches[@]}"; do
    if [ "$branch" != "$current_branch" ]; then
      skip_worktree_branch $branch && continue
      remove_local_branch $branch
    fi
  done
fi


# reset
if [ -n "$reset" ]; then
  while true; do
    read -p "Are you sure you want to remove all local branches not on $reset? " choice
    case $(echo $choice | tr '[A-Z]' '[a-z]') in
      y|yes) break;;
      *) exit;;
    esac
  done

  git fetch -p $reset > /dev/null 2>&1

  remote_branches=( $(git ls-remote --heads origin | cut -f 2) )
  local_branches=( $(git branch | grep -v '^\*' | cut -c3-) )
  branches=()

  for branch in "${local_branches[@]}"; do
    [[ ! " ${remote_branches[*]} " =~ " refs/heads/${branch} " ]] && branches+=($branch)
  done

  branches=( $(filter_branches "${branches[@]}") )

  if [ ${#branches} -eq 0 ]; then
    nothing_to_trim "No branches need to be trimmed."
  fi

  for branch in "${branches[@]}"; do
    skip_worktree_branch $branch && continue
    remove_local_branch $branch
  done
fi


exit 0
